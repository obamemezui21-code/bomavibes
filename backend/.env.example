PORT=5000

# HMAC secret for the self-hosted visible math captcha on the signup form —
# any random string works (e.g. `openssl rand -hex 32`), just keep it stable
# so tokens survive a restart.
CAPTCHA_SECRET="your-random-secret"

RESEND_API_KEY="re_xxxxxxxx"
FRONTEND_URL="https://bomavibes.tech"
RESEND_FROM="BomaVibes <onboarding@resend.dev>"

# Firebase Admin SDK credentials — from the service account JSON
# (Firebase Console > Project settings > Service accounts > Generate new
# private key). Preferred over committing serviceAccountKey.json to the
# server; if unset, backend/src/config/firebaseAdmin.js falls back to that
# file. FIREBASE_PRIVATE_KEY must keep its literal "\n" line breaks.
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxx\n-----END PRIVATE KEY-----\n"

# Audio/video calls — TURN relay (coturn on the VPS, see
# deployment/coturn-setup.md). TURN_SECRET must equal coturn's
# `static-auth-secret`; TURN_HOST is the public hostname/IP coturn listens on.
# Leave both unset to run calls on public STUN only (no relay).
TURN_SECRET="your-random-secret"
TURN_HOST="bomavibes.tech"

# SingPay — in-app Mobile Money (Airtel Money / Moov Money, Gabon) for plan
# payments. Leave empty to keep the WhatsApp-only flow. Values come from
# SingPay Workspace (wallet details). Set the wallet's callback URL to
# https://bomavibes.tech/api/payments/singpay/callback
SINGPAY_CLIENT_ID="4cb62058-645a-417a-9f9d-be5ec9bae1f6"
SINGPAY_CLIENT_SECRET="f60b83a7b825eb5fbf284919401db33f1a230904871eec2f7057af1a18f31da0"
SINGPAY_WALLET_ID="6979e3f3fb89d230d2372657"
# Optional
SINGPAY_DISBURSEMENT=""
# SINGPAY_GATEWAY_URL="https://gateway.singpay.ga/v1"
