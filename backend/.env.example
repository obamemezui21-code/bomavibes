PORT=5000

# Cloudflare Turnstile secret key (signup anti-bot check). The matching
# public site key is in frontend-web/src/components/TurnstileWidget.jsx.
# Without it, email/password signups are refused.
TURNSTILE_SECRET="0x4AAAAAAA..."

RESEND_API_KEY="re_xxxxxxxx"
FRONTEND_URL="https://bomavibes.tech"
RESEND_FROM="BomaVibes <onboarding@resend.dev>"

# Firebase Admin SDK credentials — from the service account JSON
# (Firebase Console > Project settings > Service accounts > Generate new
# private key). Preferred over committing serviceAccountKey.json to the
# server; if unset, backend/src/config/firebaseAdmin.js falls back to that
# file. FIREBASE_PRIVATE_KEY must keep its literal "\n" line breaks.
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxx\n-----END PRIVATE KEY-----\n"

# Audio/video calls — TURN relay (coturn on the VPS, see
# deployment/coturn-setup.md). TURN_SECRET must equal coturn's
# `static-auth-secret`; TURN_HOST is the public hostname/IP coturn listens on.
# Leave both unset to run calls on public STUN only (no relay).
TURN_SECRET="your-random-secret"
TURN_HOST="bomavibes.tech"

# Monerails — in-app Mobile Money (Airtel Money / Moov Money, Gabon). Takes
# over from SingPay once set (or choose with PAYMENT_PROVIDER). Start with a
# test key (mr_test_…): only admins can pay then, with the test number
# 24100000001. Webhook endpoint (Monerails dashboard › Developers › Webhooks):
# https://bomavibes.tech/api/payments/monerails/webhook, events collection.*
# MONERAILS_API_KEY=mr_test_...
# MONERAILS_WEBHOOK_SECRET=whsec_...
# PAYMENT_PROVIDER=monerails        # monerails | singpay | auto (default)

# SingPay — in-app Mobile Money (Airtel Money / Moov Money, Gabon) for plan
# payments. Leave empty to keep the WhatsApp-only flow. Values come from
# SingPay Workspace (wallet details). Set the wallet's callback URL to
# https://bomavibes.tech/api/payments/singpay/callback
SINGPAY_CLIENT_ID="your-singpay-client-id"
SINGPAY_CLIENT_SECRET="your-singpay-client-secret"
SINGPAY_WALLET_ID="your-singpay-wallet-id"
# Optional
SINGPAY_DISBURSEMENT=""
# SINGPAY_GATEWAY_URL="https://gateway.singpay.ga/v1"

# Group calls (and lives) — LiveKit media server on the VPS, see
# deployment/livekit-setup.md. Without these, group calls are unavailable.
LIVEKIT_URL="wss://bomavibes.tech/livekit"
LIVEKIT_API_KEY="APIxxxxxxxxxxxx"
LIVEKIT_API_SECRET="your-livekit-secret"

# CV PNPE (/cv) — CVs written by Claude (Anthropic). Key from
# https://platform.claude.com (Settings > API keys); billed per CV (~0.08 $).
# Without it, the page is shown but writing is unavailable.
ANTHROPIC_API_KEY="sk-ant-xxxxxxxx"
# Optional: CVs per member per day (default 3) and for everyone per day (default 300).
# CV_DAILY_LIMIT=3
# CV_MAX_PER_DAY=300

# EDU-CHECK, the homework-analysis module (src/eduCheck/README.md). All optional.
# EDU_CHECK_MAX_FILE_MB=5
# EDU_CHECK_MAX_WORDS=20000
# EDU_CHECK_MIN_WORDS=150
# EDU_CHECK_RETENTION_DAYS=180
# EDU_CHECK_MAX_SOURCE_LOOKUPS=15
# EDU_CHECK_SOURCE_VERIFICATION=off   # no lookups in Crossref / OpenAlex
# EDU_CHECK_AI_PROVIDER=              # reserved for the optional AI engine (not wired)
# EDU_CHECK_ISGENAI=off               # hide the "isGenAI" option: no text ever sent to isgenai.com
# EDU_CHECK_ML_ENGINE=binoculars      # local language-model estimate (~1.5 GB RAM while working; see src/eduCheck/README.md)
# EDU_CHECK_ML_THREADS=2
