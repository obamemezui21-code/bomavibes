PORT=5000

RESEND_API_KEY="re_xxxxxxxx"
FRONTEND_URL="https://bomavibes.tech"
RESEND_FROM="BomaVibes <onboarding@resend.dev>"

# Firebase Admin SDK credentials — from the service account JSON
# (Firebase Console > Project settings > Service accounts > Generate new
# private key). Preferred over committing serviceAccountKey.json to the
# server; if unset, backend/src/config/firebaseAdmin.js falls back to that
# file. FIREBASE_PRIVATE_KEY must keep its literal "\n" line breaks.
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxx\n-----END PRIVATE KEY-----\n"
