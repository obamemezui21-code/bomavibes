rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') in ['admin', 'super_admin'];
    }

    function isContentEditor() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') in ['admin', 'super_admin', 'editor'];
    }

    function isOptionalString(field, maxLen) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (request.resource.data[field] is string && request.resource.data[field].size() <= maxLen);
    }

    function isBlockedByRecipient(matchId) {
      let matchUsers = get(/databases/$(database)/documents/matches/$(matchId)).data.users;
      let otherUid = matchUsers[0] == request.auth.uid ? matchUsers[1] : matchUsers[0];
      return exists(/databases/$(database)/documents/blocks/$(otherUid + '_' + request.auth.uid));
    }

    match /users/{userId} {
      function validAccountShape() {
        let data = request.resource.data;
        return data.email is string
          && data.onboarded is bool
          && isOptionalString('firstName', 50)
          && (!('prefGender' in data) || data.prefGender == null || (data.prefGender is string && data.prefGender.size() <= 20))
          && (!('prefMaxDistance' in data) || data.prefMaxDistance == null || (data.prefMaxDistance is number && data.prefMaxDistance >= 1 && data.prefMaxDistance <= 500))
          // role (and the legacy isAdmin flag) are granted only server-side
          // via the Admin SDK — a client write may leave them untouched but
          // never set or change them, so a user can't self-promote by
          // writing to their own account doc, and an Admin can't grant
          // themselves super_admin this way either.
          // (resource is null on create, i.e. no prior role to defend.)
          && (!('role' in data) || (resource != null && data.role == resource.data.get('role', 'user')))
          && (!('isAdmin' in data) || (resource != null && data.isAdmin == resource.data.get('isAdmin', false)))
          // Same reasoning as role: only the Admin SDK (account deletion,
          // see accountController.js) may ever set these, so a user can't
          // fake or clear their own "deleted" tombstone.
          && (!('deleted' in data) || (resource != null && data.deleted == resource.data.get('deleted', false)))
          && (!('deletedAt' in data) || (resource != null && data.deletedAt == resource.data.get('deletedAt', null)));
      }

      // Account deletion is a full erasure (see accountController.deleteAccount:
      // most fields are dropped, not just flagged) done via the Admin SDK,
      // which bypasses these rules — a client can never delete or directly
      // erase its own doc, only ask the backend to do it.
      allow read: if isOwner(userId);
      allow delete: if false;
      allow create, update: if isOwner(userId) && validAccountShape();
    }

    match /profiles/{userId} {
      function validPublicProfile() {
        let data = request.resource.data;
        return isOptionalString('firstName', 50)
          && isOptionalString('lastName', 50)
          && isOptionalString('bio', 500)
          && isOptionalString('city', 100)
          && isOptionalString('country', 100)
          && isOptionalString('gender', 20)
          && (!('age' in data) || data.age == null || (data.age is number && data.age >= 18 && data.age <= 120))
          && (!('interests' in data) || (data.interests is list && data.interests.size() <= 20))
          && (!('photos' in data) || (data.photos is list && data.photos.size() <= 3));
      }

      function verifiedUnchanged() {
        return request.resource.data.verified == resource.data.get('verified', false);
      }

      allow read: if isSignedIn();
      allow create: if isOwner(userId) && validPublicProfile()
        && (!('verified' in request.resource.data) || request.resource.data.verified == false);
      allow update: if isOwner(userId) && validPublicProfile() && verifiedUnchanged();
      allow delete: if isOwner(userId);
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if false; // created only server-side via the Admin SDK
    }

    match /campaign/{campaignId} {
      allow read: if isSignedIn();
      allow write: if false; // set only server-side via the Admin SDK
    }

    match /settings/{settingsId} {
      // Fully public (unlike announcements/campaign above) — maintenanceMode
      // has to gate the app for a signed-out visitor too, checked before
      // App.jsx even knows whether anyone is logged in. No secret ever lives
      // here (see settingsController.js); write is Admin SDK only.
      allow read: if true;
      allow write: if false;
    }

    match /admin_logs/{logId} {
      // Written by adminLogService.js and read via GET /api/admin/logs —
      // both through the Admin SDK, which bypasses this. No client, admin
      // included, ever reads or writes this collection directly.
      allow read, write: if false;
    }

    // CMS content (Pages/Articles/FAQ/Bannières) — all four share this same
    // shape: public can read published items (even signed out, since legal
    // pages/FAQ are reachable pre-login), an Editor/Admin/Super Admin can
    // also read drafts to preview them, and every write goes through
    // contentController.js via the Admin SDK (slug uniqueness and field
    // validation live there, not here) — never directly from a client, not
    // even an Editor's.
    match /pages/{pageId} {
      allow read: if resource.data.status == 'published' || isContentEditor();
      allow write: if false;
    }

    match /articles/{articleId} {
      allow read: if resource.data.status == 'published' || isContentEditor();
      allow write: if false;
    }

    match /faqs/{faqId} {
      allow read: if resource.data.status == 'published' || isContentEditor();
      allow write: if false;
    }

    match /banners/{bannerId} {
      allow read: if resource.data.status == 'published' || isContentEditor();
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if resource.data.status == 'published' || isContentEditor();
      allow write: if false;
    }

    match /venues/{venueId} {
      allow read: if resource.data.status == 'published' || isContentEditor();
      allow write: if false;
    }

    // Studio IA — affiliate directory. No draft/published lifecycle like the
    // content types above (a simple `actif` boolean instead), and unlike
    // them writes go through aiPartnersController.js with an Admin/Super
    // Admin check (narrower than isContentEditor()'s Editor-inclusive
    // access — commission links are more sensitive than CMS copy).
    match /aiPartners/{partnerId} {
      allow read: if true;
      allow write: if false;
    }

    // Click tracking for the affiliate links above. Any visitor (signed in
    // or not) can log a click, but only ever their own uid (or none), and
    // only the three fields the click actually needs — never edited or
    // deleted once written, and only admins can read the log back (used for
    // the per-partner stats in the admin Studio IA section).
    match /aiClicks/{clickId} {
      allow create: if request.resource.data.keys().hasOnly(['partnerId', 'userId', 'date'])
        && request.resource.data.partnerId is string
        && (request.resource.data.userId == null || (isSignedIn() && request.resource.data.userId == request.auth.uid))
        && request.resource.data.date == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /tickets/{ticketId} {
      // A user can read their own reservations directly (e.g. a live "Mes
      // billets" listener) but never write one — reserving/cancelling has to
      // go through eventTicketController.js's transaction so the
      // ticketsReserved counter on the event and the one-ticket-per-user
      // guard stay correct. No admin override needed here: event capacity is
      // managed via the event doc, not by editing individual tickets.
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /contributionInterest/{interestId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId != request.auth.uid
        && request.resource.data.reason is string;
      allow read, update, delete: if false; // reviewed only server-side via the Admin SDK
    }

    match /blocks/{blockId} {
      allow read: if isSignedIn()
        && (resource == null || resource.data.blockerId == request.auth.uid || resource.data.blockedId == request.auth.uid);
      allow create: if isSignedIn()
        && blockId == request.auth.uid + '_' + request.resource.data.blockedId
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId != request.auth.uid;
      allow delete: if isSignedIn() && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    match /swipes/{swipeId} {
      allow read: if isSignedIn()
        && (resource == null || resource.data.swiperId == request.auth.uid || resource.data.targetId == request.auth.uid);
      allow create, update: if isSignedIn()
        && swipeId == request.auth.uid + '_' + request.resource.data.targetId
        && request.resource.data.swiperId == request.auth.uid
        && request.resource.data.targetId != request.auth.uid
        && request.resource.data.direction in ['like', 'pass', 'superlike'];
      allow delete: if false;
    }

    match /matches/{matchId} {
      function hasLiked(fromUid, toUid) {
        let swipePath = /databases/$(database)/documents/swipes/$(fromUid + '_' + toUid);
        return exists(swipePath) && get(swipePath).data.direction in ['like', 'superlike'];
      }

      // Per-user maps (typing, activeIn, lastReadAt): each user may only
      // touch their own entry.
      function onlyOwnEntry(field) {
        return request.resource.data.get(field, {}).diff(resource.data.get(field, {})).affectedKeys()
          .hasOnly([request.auth.uid]);
      }

      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.users);
      // A match only exists when both people liked each other (see
      // recordSwipeAndMatch in swipes.js): its id is the two sorted uids and
      // both swipes must be likes — nobody can open a conversation (or a
      // call) with someone who didn't like them back.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['users', 'createdAt', 'lastMessage', 'lastMessageAt', 'seen'])
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users[0] < request.resource.data.users[1]
        && matchId == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && hasLiked(request.resource.data.users[0], request.resource.data.users[1])
        && hasLiked(request.resource.data.users[1], request.resource.data.users[0]);
      // Participants can only update the chat bookkeeping fields — never
      // `users` (which would let someone add a third person) or createdAt.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.users
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastMessageAt', 'seen', 'typing', 'activeIn', 'lastReadAt'])
        && (request.resource.data.get('lastMessage', null) == null
          || (request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 2000))
        && request.resource.data.get('seen', {}).keys().hasOnly(resource.data.users)
        && onlyOwnEntry('typing')
        && onlyOwnEntry('activeIn')
        && onlyOwnEntry('lastReadAt');
      allow delete: if false;

      match /messages/{messageId} {
        function isMatchParticipant() {
          return isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users;
        }

        // The sender edits the text of their own text message — nothing
        // else (no turning a message into a fake call / invite / post).
        function isOwnTextEdit() {
          return resource.data.senderId == request.auth.uid
            && resource.data.get('type', 'text') == 'text'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 2000;
        }

        // Either participant sets or clears their own reaction, on any
        // message (the other person's included) — only their own entry.
        function isOwnReaction() {
          let after = request.resource.data.get('reactions', {});
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && after.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
            && (!(request.auth.uid in after) || (after[request.auth.uid] is string && after[request.auth.uid].size() <= 16));
        }

        allow read: if isMatchParticipant();
        allow create: if isMatchParticipant()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.get('type', 'text')
            in ['text', 'voice', 'image', 'file', 'sticker', 'post', 'venue-invite', 'call']
          && !isBlockedByRecipient(matchId);
        allow update: if isMatchParticipant() && (isOwnTextEdit() || isOwnReaction());
        allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // Audio/video calls — WebRTC signaling (see src/firebase/calls.js).
    // Only the two people of an existing match can call each other, never
    // someone who blocked the caller; afterwards only the two participants
    // can read the call or move its status along.
    match /calls/{callId} {
      function isParticipant(data) {
        return isSignedIn() && (request.auth.uid == data.callerId || request.auth.uid == data.calleeId);
      }

      allow read: if isParticipant(resource.data);
      allow create: if isSignedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.type in ['audio', 'video']
        && request.resource.data.status == 'ringing'
        && request.resource.data.matchId is string
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.users
        && request.resource.data.calleeId in get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.users
        && !isBlockedByRecipient(request.resource.data.matchId);
      allow update: if isParticipant(resource.data)
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.calleeId == resource.data.calleeId
        && request.resource.data.matchId == resource.data.matchId
        && request.resource.data.type == resource.data.type
        && request.resource.data.status in ['ringing', 'accepted', 'ended', 'declined', 'missed', 'busy', 'cancelled'];
      allow delete: if false;

      match /callerCandidates/{candidateId} {
        allow read: if isParticipant(get(/databases/$(database)/documents/calls/$(callId)).data);
        allow create: if isSignedIn()
          && request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId;
        allow update, delete: if false;
      }

      match /calleeCandidates/{candidateId} {
        allow read: if isParticipant(get(/databases/$(database)/documents/calls/$(callId)).data);
        allow create: if isSignedIn()
          && request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeId;
        allow update, delete: if false;
      }
    }

    match /posts/{postId} {
      function validPostCreate() {
        let data = request.resource.data;
        return data.authorId is string
          && data.type in ['text', 'photo', 'question']
          && isOptionalString('text', 1000)
          // Text-post style preset ids (lib/postStyles.js)
          && isOptionalString('background', 30)
          && isOptionalString('font', 30)
          && (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500))
          && (data.type != 'photo' || (data.photoUrl is string && data.photoUrl.size() > 0))
          && (data.type == 'photo' || (data.text is string && data.text.size() > 0))
          && data.likeCount == 0 && data.commentCount == 0;
      }

      function isCounterOnlyBump(field) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
          && request.resource.data[field] >= 0
          && (request.resource.data[field] == resource.data[field] + 1
              || request.resource.data[field] == resource.data[field] - 1);
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid && validPostCreate();
      allow update: if isSignedIn() && (
        (isOwner(resource.data.authorId)
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.type == resource.data.type
          && request.resource.data.photoUrl == resource.data.photoUrl
          && request.resource.data.likeCount == resource.data.likeCount
          && request.resource.data.commentCount == resource.data.commentCount
          && request.resource.data.get('background', null) == resource.data.get('background', null)
          && request.resource.data.get('font', null) == resource.data.get('font', null)
          && isOptionalString('text', 1000))
        || isCounterOnlyBump('likeCount')
        || isCounterOnlyBump('commentCount')
      );
      allow delete: if isSignedIn() && isOwner(resource.data.authorId);

      match /comments/{commentId} {
        function validComment() {
          let data = request.resource.data;
          return data.authorId is string && data.text is string
            && data.text.size() > 0 && data.text.size() <= 500
            && (!('parentCommentId' in data) || data.parentCommentId == null || data.parentCommentId is string);
        }

        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid && validComment();
        allow update: if isSignedIn() && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.text is string && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
      }

      match /likes/{uid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && uid == request.auth.uid;
        allow delete: if isSignedIn() && uid == request.auth.uid;
        allow update: if false;
      }
    }

    match /stories/{storyId} {
      function validStoryCreate() {
        let data = request.resource.data;
        return data.authorId is string
          && data.type in ['text', 'photo']
          && isOptionalString('text', 300)
          && isOptionalString('background', 50)
          && (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500))
          && (data.type != 'photo' || (data.photoUrl is string && data.photoUrl.size() > 0))
          && (data.type == 'text' || (data.text is string && data.text.size() > 0))
          && data.viewedBy is list && data.viewedBy.size() == 0;
      }

      // Anyone signed in can mark themselves as having seen a story — only
      // the viewedBy field may change, and only to grow by the requester's
      // own uid. Same trust model as this project's other client-writable
      // counters/flags (seen, lastMessage, reactions) — no Cloud Functions
      // here to verify it server-side.
      function isViewMark() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy'])
          && request.auth.uid in request.resource.data.viewedBy
          && request.resource.data.viewedBy.size() <= resource.data.viewedBy.size() + 1;
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid && validStoryCreate();
      allow update: if isSignedIn() && isViewMark();
      allow delete: if isSignedIn() && isOwner(resource.data.authorId);
    }

    match /musicTracks/{trackId} {
      function validMusicTrack() {
        let data = request.resource.data;
        return data.title is string && data.title.size() > 0 && data.title.size() <= 200
          && data.url is string && data.url.size() > 0
          && data.uploadedBy == request.auth.uid;
      }

      // Admin-only module for now (upload and playback both) — not the
      // general user-facing feed/chat trust model used elsewhere in this
      // file.
      allow read: if isAdmin();
      allow create: if isAdmin() && validMusicTrack();
      allow update: if isAdmin() && request.resource.data.uploadedBy == resource.data.uploadedBy;
      allow delete: if isAdmin();
    }
  }
}
