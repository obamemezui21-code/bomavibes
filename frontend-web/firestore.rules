rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isOptionalString(field, maxLen) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (request.resource.data[field] is string && request.resource.data[field].size() <= maxLen);
    }

    function isBlockedByRecipient(matchId) {
      let matchUsers = get(/databases/$(database)/documents/matches/$(matchId)).data.users;
      let otherUid = matchUsers[0] == request.auth.uid ? matchUsers[1] : matchUsers[0];
      return exists(/databases/$(database)/documents/blocks/$(otherUid + '_' + request.auth.uid));
    }

    match /users/{userId} {
      function validAccountShape() {
        let data = request.resource.data;
        return data.email is string
          && data.onboarded is bool
          && isOptionalString('firstName', 50)
          && (!('prefGender' in data) || data.prefGender == null || (data.prefGender is string && data.prefGender.size() <= 20))
          && (!('prefMaxDistance' in data) || data.prefMaxDistance == null || (data.prefMaxDistance is number && data.prefMaxDistance >= 1 && data.prefMaxDistance <= 500));
      }

      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validAccountShape();
    }

    match /profiles/{userId} {
      function validPublicProfile() {
        let data = request.resource.data;
        return isOptionalString('firstName', 50)
          && isOptionalString('lastName', 50)
          && isOptionalString('bio', 500)
          && isOptionalString('city', 100)
          && isOptionalString('country', 100)
          && isOptionalString('gender', 20)
          && (!('age' in data) || data.age == null || (data.age is number && data.age >= 18 && data.age <= 120))
          && (!('interests' in data) || (data.interests is list && data.interests.size() <= 20))
          && (!('photos' in data) || (data.photos is list && data.photos.size() <= 3));
      }

      function verifiedUnchanged() {
        return request.resource.data.verified == resource.data.get('verified', false);
      }

      allow read: if isSignedIn();
      allow create: if isOwner(userId) && validPublicProfile()
        && (!('verified' in request.resource.data) || request.resource.data.verified == false);
      allow update: if isOwner(userId) && validPublicProfile() && verifiedUnchanged();
      allow delete: if isOwner(userId);
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if false; // created only server-side via the Admin SDK
    }

    match /campaign/{campaignId} {
      allow read: if isSignedIn();
      allow write: if false; // set only server-side via the Admin SDK
    }

    match /contributionInterest/{interestId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId != request.auth.uid
        && request.resource.data.reason is string;
      allow read, update, delete: if false; // reviewed only server-side via the Admin SDK
    }

    match /blocks/{blockId} {
      allow read: if isSignedIn()
        && (resource == null || resource.data.blockerId == request.auth.uid || resource.data.blockedId == request.auth.uid);
      allow create: if isSignedIn()
        && blockId == request.auth.uid + '_' + request.resource.data.blockedId
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId != request.auth.uid;
      allow delete: if isSignedIn() && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    match /swipes/{swipeId} {
      allow read: if isSignedIn()
        && (resource == null || resource.data.swiperId == request.auth.uid || resource.data.targetId == request.auth.uid);
      allow create, update: if isSignedIn()
        && swipeId == request.auth.uid + '_' + request.resource.data.targetId
        && request.resource.data.swiperId == request.auth.uid
        && request.resource.data.targetId != request.auth.uid
        && request.resource.data.direction in ['like', 'pass', 'superlike'];
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.users);
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users.size() == 2;
      allow update: if isSignedIn() && request.auth.uid in resource.data.users;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users
          && request.resource.data.senderId == request.auth.uid
          && !isBlockedByRecipient(matchId);
        allow update: if isSignedIn()
          && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
        allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
